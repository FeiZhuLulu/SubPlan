{
  "schemaVersion": "0.4.7",
  "lastUpdatedAt": "2026-07-30",
  "methodology": {
    "principle": "Unified metric set per dimension. Missing = null. Frontend primary = Arena (Code Arena Fullstack/Frontend), not ad-hoc proxies.",
    "metrics": {
      "aaIntelligenceIndex": {
        "id": "aaIntelligenceIndex",
        "label": "Artificial Analysis Intelligence Index v4.1",
        "unit": "index",
        "comparableAcrossModels": true,
        "harness": "Artificial Analysis (same eval suite for all models)",
        "sources": [
          "https://artificialanalysis.ai/",
          "https://openai.com/index/gpt-5-6/"
        ],
        "asOf": "2026-07",
        "role": "general_intelligence"
      },
      "swebenchVerifiedVals": {
        "id": "swebenchVerifiedVals",
        "label": "SWE-bench Verified % (Vals AI Mini-SWE-agent)",
        "unit": "percent",
        "comparableAcrossModels": true,
        "harness": "Vals AI Mini-SWE-agent (single harness)",
        "sources": [
          "https://vals.ai/benchmarks/swebench"
        ],
        "asOf": "2026-07-22",
        "role": "coding_patch_quality"
      },
      "aaCodingAgentIndex": {
        "id": "aaCodingAgentIndex",
        "label": "Artificial Analysis Coding Agent Index",
        "unit": "index",
        "comparableAcrossModels": "limited_harness_coupled",
        "harness": "AA Coding Agent Index components (DeepSWE, Terminal-Bench, SWE-Atlas-QnA) with model-native agent harness",
        "sources": [
          "https://artificialanalysis.ai/articles/gpt-5-6-has-landed",
          "https://openai.com/index/gpt-5-6/"
        ],
        "asOf": "2026-07",
        "role": "agent_coding_secondary",
        "caveat": "Index score is somewhat harness-coupled. Used only as a secondary weight, never as the sole coding score, and never replaced by a different coding bench when missing."
      },
      "arenaFrontendCode": {
        "id": "arenaFrontendCode",
        "label": "Arena.ai Frontend / Fullstack Code Arena (rank or Elo when published)",
        "unit": "rank_or_elo",
        "comparableAcrossModels": true,
        "harness": "Arena Code (community human preference / fullstack-frontend arena)",
        "sources": [
          "https://arena.ai/",
          "community reports of Code Arena Fullstack leaderboard (2026-07)"
        ],
        "asOf": "2026-07",
        "role": "frontend_primary",
        "note": "PRIMARY = Frontend Code Arena scores from Arena chart (user screenshot + arena.ai). Not WebDev Overall.",
        "scraped": true,
        "board": "Frontend Code Arena"
      },
      "grokBuildCodingAgent": {
        "id": "grokBuildCodingAgent",
        "label": "AA Coding Agent Index in Grok Build harness",
        "unit": "index",
        "comparableAcrossModels": "limited_harness_coupled",
        "harness": "Grok Build (xAI coding agent CLI) — AA Coding Agent Index components",
        "sources": [
          "https://artificialanalysis.ai/articles/grok-4-5-brings-spacexai-to-the-the-intelligence-frontier",
          "https://x.ai/news/grok-4-5"
        ],
        "asOf": "2026-07",
        "role": "agent_coding_grok_build",
        "note": "Grok-native harness. Score 76 for Grok 4.5; avg ~1.9M tokens/task (vs Fable Claude Code ~7.2M, GPT-5.5 Codex ~6.2M)."
      }
    },
    "normalization": {
      "method": "value / frontier_max_in_matrix * 100",
      "frontierMax": {
        "aaIntelligenceIndex": 61,
        "swebenchVerifiedVals": 97,
        "aaCodingAgentIndex": 80
      },
      "note": "Same ceiling for every model. No lo/hi window that over-penalizes mid-frontier."
    },
    "modelScoreFormula": {
      "codingFamily": "PRIMARY ONLY: 0.55*norm(Vals SWE-bench Verified) + 0.45*norm(AA Intelligence Index). If one missing: use the other * 0.97 (medium confidence). AA Coding Agent Index is recorded but NOT mixed into the score (harness-coupled).",
      "research": "Primarily norm(AA Intelligence); else coding base.",
      "productOnlyDims": [
        "chineseWriting",
        "imageGeneration",
        "multimodal",
        "ecosystem"
      ],
      "planScore": "quotaShare-weighted average of model derived scores + fixed product deltas (not alternate benches).",
      "frontend": "PRIMARY: Arena Frontend/Fullstack Code Arena rank. Map rank→0-100 relative, then apply as DELTA on HEAD plan scores (dataset scale). Do not use SWE-bench or AA Coding Agent as frontend primary.",
      "grokBuild": "Grok Build is SuperGrok/X Premium+ coding path. Prefer Grok Build Coding Agent Index + token/task when discussing Grok coding efficiency."
    },
    "nonGoals": [
      "Do not use vendor-only SWE-bench Pro to fill missing Vals SWE cells.",
      "Do not use non-Arena proxies as primary frontend when Arena rank exists for the model.",
      "Do not mix AA Coding Agent Index into primary scores across different agent harnesses without labeling harness.",
      "Do not use Sol Pro (not in Codex path).",
      "Do not treat kimi-k2.5 as current product model."
    ],
    "planScore": "quotaShare-weighted evidence informs DELTAS on HEAD plan scores; absolute plan scores stay on dataset scale (v0.4.1)."
  },
